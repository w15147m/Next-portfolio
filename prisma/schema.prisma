// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────
model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false) @map("email_verified")
  image         String?
  password      String?
  address       String?
  number        String?
  desc          String?     @db.Text          // Short bio / hero paragraph / meta description
  subDesc       String?     @db.Text @map("sub_desc")  // Hero tagline e.g. "I build things for the web."
  about         String?     @db.Text          // Long-form About Me body text (multi-paragraph)
  openForWork   Boolean     @default(false) @map("open_for_work")  // "Open to opportunities" badge
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt      @map("updated_at")

  sessions           Session[]
  accounts           Account[]
  skills             Skill[]
  projects           Project[]
  services           Service[]
  socials            Social[]
  experiences        Experience[]
  educations         Education[]
  testimonials       Testimonial[]

  @@map("users")
}

// ─────────────────────────────────────────────
// SKILLS
// ─────────────────────────────────────────────
model Skill {
  id          BigInt   @id @default(autoincrement())
  userId      String   @map("user_id")
  name        String
  proficiency String?
  image       String?
  desc        String?
  isCore      Boolean  @default(false) @map("is_core")  // Shown in About Me bullet list
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectSkills ProjectSkill[]

  @@map("skills")
}

// ─────────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────────
model Project {
  id          BigInt   @id @default(autoincrement())
  userId      String   @map("user_id")
  name        String
  image       String?
  desc        String?  @db.Text
  github      String?                         // GitHub repo URL
  external    String?                         // Live demo / external URL
  type        String?                         // "web" | "mobile" | "desktop" | "open-source"
  featured    Boolean  @default(false)        // Show on main portfolio (vs archive)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectImages      ProjectImage[]
  projectSkills      ProjectSkill[]
  experienceProjects ExperienceProject[]

  @@map("projects")
}

// ─────────────────────────────────────────────
// PROJECT_IMAGES
// ─────────────────────────────────────────────
model ProjectImage {
  id        BigInt   @id @default(autoincrement())
  projectId BigInt   @map("projects_id")
  image     String
  isDefault Boolean  @default(false) @map("default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_images")
}

// ─────────────────────────────────────────────
// PROJECT_SKILLS  (pivot / many-to-many)
// ─────────────────────────────────────────────
model ProjectSkill {
  id        BigInt   @id @default(autoincrement())
  projectId BigInt   @map("projects_id")
  skillId   BigInt   @map("skills_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId],   references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
  @@map("project_skills")
}

// ─────────────────────────────────────────────
// SERVICES
// ─────────────────────────────────────────────
model Service {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  name      String
  desc      String?
  link      String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("services")
}

// ─────────────────────────────────────────────
// SOCIALS
// ─────────────────────────────────────────────
model Social {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  name      String
  desc      String?
  link      String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("socials")
}

// ─────────────────────────────────────────────
// EXPERIENCES
// ─────────────────────────────────────────────
model Experience {
  id        BigInt    @id @default(autoincrement())
  userId    String    @map("user_id")
  company   String
  position  String
  image     String?
  url       String?                           // Company website URL
  location  String?                           // "Remote" | "New York, NY" | etc.
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date")   @db.Date
  desc      String?   @db.Text
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceProjects ExperienceProject[]

  @@map("experiences")
}

// ─────────────────────────────────────────────
// EXPERIENCE_PROJECTS  (pivot — Experience ↔ Project)
// ─────────────────────────────────────────────
model ExperienceProject {
  id           BigInt   @id @default(autoincrement())
  experienceId BigInt   @map("experience_id")
  projectId    BigInt   @map("project_id")
  createdAt    DateTime @default(now()) @map("created_at")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId],    references: [id], onDelete: Cascade)

  @@unique([experienceId, projectId])
  @@map("experience_projects")
}

// ─────────────────────────────────────────────
// EDUCATIONS
// ─────────────────────────────────────────────
model Education {
  id           BigInt    @id @default(autoincrement())
  userId       String    @map("user_id")
  institution  String
  degree       String
  fieldOfStudy String?   @map("field_of_study")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date")   @db.Date
  desc         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("educations")
}

// ─────────────────────────────────────────────
// BETTER AUTH MODELS
// ─────────────────────────────────────────────
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text @map("access_token")
  refreshToken          String?   @db.Text @map("refresh_token")
  idToken               String?   @db.Text @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

// ─────────────────────────────────────────────
// NEW ADDITIONS
// ─────────────────────────────────────────────
model TempImage {
  id        String   @id @default(cuid())
  url       String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("temp_images")
}

model ContactMessage {
  id        BigInt   @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model Testimonial {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  name      String
  role      String?
  company   String?
  image     String?
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("testimonials")
}
